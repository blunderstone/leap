{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/resources/schema.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "prerelease": true,
      "prerelease-type": "rc",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "docs", "section": "Documentation Standards & Guides" },
        { "type": "refactor", "section": "Refactoring & Cleanup" }
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "check-md/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        "check-md/src/check_md/__init__.py"
      ]
    }
  }
}
